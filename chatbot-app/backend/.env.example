# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
# Available defaults: gpt-4o, gpt-4o-mini, qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
DEFAULT_MODEL=gpt-4o

# System Persona / Default Instruction
DEFAULT_SYSTEM_PROMPT="You are SuperBot, a knowledgeable, concise, and helpful AI assistant."

# Persistence & Storage
DATABASE_URL=sqlite:///./chatbot.db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=4000
